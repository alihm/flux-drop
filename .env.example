# Required: deliver privately through Flux/Enterprise configuration, not public
# app specifications. Use the same strong random secret on all replicas.
# DROP_CLUSTER_PASSPHRASE=<32-to-1024-byte-secret>

# Flux supplies FLUX_APP_NAME and FLUX_NODE_HOST_IP; hostinfo is the fallback.
# Replicate /data only. Persist /var/lib/drop-cluster WITHOUT replication.
# Map container ports 34444,34445,34446 to the SAME external port numbers.
# Public Nginx is container port 8080 behind Flux HTTPS ingress.

# Optional staging gate, independent of the cluster secret. Without this,
# passphrase-mode publishing is public as intended for the free Drop service.
# DROP_STAGING_PASSWORD=<20+-character-test-access-password>
# DROP_STAGING_USER=tester

# Optional overrides. Automatic mode enables publishing, peers and cleanup.
# DROP_PUBLIC_ORIGIN=https://custom-domain.example
# DROP_PUBLISHING_ENABLED=false
# DROP_PEERS_ENABLED=false
# DROP_MAINTENANCE_ENABLED=false
# DROP_ANONYMOUS_BYTE_LIMIT=1073741824
# DROP_ACCOUNT_BYTE_LIMIT=10737418240
# DROP_SESSION_CREATIONS_PER_MINUTE=60

# Public Firebase browser identifiers default to Orbit's fluxcore-prod app.
# No service-account credentials or manually supplied cluster CA required.
# FIREBASE_PROJECT_ID=
# DROP_FIREBASE_WEB_API_KEY=
# DROP_FIREBASE_WEB_APP_ID=

# Optional fresh multi-app storage deployment. See docs/STORAGE_POOL.md.
# Leave DROP_ROLE unset for the existing standalone runtime.
# PRIMARY (normally 3 instances; keep the private cluster passphrase above):
# DROP_ROLE=primary
# Wallet dashboard at /admin/; defaults to the authorized Drop owner ZelID.
# DROP_ADMIN_ZELID=15c3aH6y9Koq1Dg1rGXE9Ypn5nL2AbSJCu
# DROP_STORAGE_APPS_JSON=[{"appName":"dropstoragea","port":35447,"keyId":"v1","apiKey":"<private-random-32+-byte-key>"}]
# DROP_STORAGE_ADMIN_KEY=<separate-private-random-32+-byte-key>
# DROP_CACHE_BYTES=268435456
#
# SECONDARY (2+ instances with /data replicated by Flux/Syncthing):
# No DROP_CLUSTER_PASSPHRASE on secondary apps.
# DROP_ROLE=secondary
# DROP_PRIMARY_APP_NAME=dropprimary
# DROP_STORAGE_PORT=35447
# DROP_STORAGE_CAPACITY_BYTES=107374182400
# DROP_STORAGE_API_KEYS_JSON={"v1":"<same-secondary-key-held-by-primary>"}
# Each secondary app needs its own direct port, private key, and replicated data.
# Both roles require r:/data|ml:state:/var/lib/drop-cluster.

# Optional agent OAuth/MCP sign-in on primary/standalone Raft. No new ports.
# See docs/AGENT_SIGNIN.md; reuses the Firebase defaults and cluster secret.
# DROP_AGENT_AUTH_ENABLED=true
# DROP_AGENT_RESOURCE=https://runonflux.com/apps/mcp
# DROP_AGENT_MCP_UPSTREAM=https://runonflux.com/apps/mcp
# DROP_AGENT_RESOURCE_METADATA=https://runonflux.com/apps/.well-known/oauth-protected-resource
# DROP_AGENT_WEBSITE_ORIGINS=https://runonflux.com
