# Required: deliver privately through Flux/Enterprise configuration, not public
# app specifications. Use the same strong random secret on all replicas.
# DROP_CLUSTER_PASSPHRASE=<32-to-1024-byte-secret>

# Flux supplies FLUX_APP_NAME and FLUX_NODE_HOST_IP; hostinfo is the fallback.
# Replicate /data only. Persist /var/lib/drop-cluster WITHOUT replication.
# Map container ports 34444,34445,34446 to the SAME external port numbers.
# Public Nginx is container port 8080 behind Flux HTTPS ingress.

# Optional staging gate, independent of the cluster secret. Without this,
# passphrase-mode publishing is public as intended for the free Drop service.
# DROP_STAGING_PASSWORD=<20+-character-test-access-password>
# DROP_STAGING_USER=tester

# Optional overrides. Automatic mode enables publishing, peers and cleanup.
# DROP_PUBLIC_ORIGIN=https://custom-domain.example
# DROP_PUBLISHING_ENABLED=false
# DROP_PEERS_ENABLED=false
# DROP_MAINTENANCE_ENABLED=false
# DROP_ANONYMOUS_BYTE_LIMIT=1073741824
# DROP_ACCOUNT_BYTE_LIMIT=10737418240
# DROP_SESSION_CREATIONS_PER_MINUTE=60

# Public Firebase browser identifiers default to Orbit's fluxcore-prod app.
# No service-account credentials or manually supplied cluster CA required.
# FIREBASE_PROJECT_ID=
# DROP_FIREBASE_WEB_API_KEY=
# DROP_FIREBASE_WEB_APP_ID=
