FROM golang:1.25.0-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY tests/browser/fixture-server ./tests/browser/fixture-server
RUN CGO_ENABLED=0 go build -o /fixture ./tests/browser/fixture-server

FROM alpine:3.22
COPY --from=build /fixture /usr/local/bin/fixture
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/fixture"]
